# Select "ollama" for a local model or "openai" for the cloud API.
AI_PROVIDER=ollama

# Response style controls: temperature 0-2, max tokens 1-8192.
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800

# Maximum wait for a model response, in seconds (1-900).
AI_TIMEOUT=300

# Ollama must be running locally and expose its OpenAI-compatible API.
OLLAMA_BASE_URL=http://localhost:11434

# Used when Thinking is off (a non-thinking/instruct model).
OLLAMA_MODEL=qwen3:4b-instruct

# Used when Thinking is on (a reasoning-capable model).
OLLAMA_THINKING_MODEL=qwen3:4b

# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
